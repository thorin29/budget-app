<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The device token lives in Keystore-encrypted storage and must never be
         backed up or moved to another phone. App data is excluded wholesale. -->
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
